{
  "name": "dsh-plugin-lucentthinker",
  "version": "0.1.0",
  "description": "LucentThinker 深度研究工作台：多轮搜索、独立网页提取与可追溯报告。",
  "type": "module",
  "main": "./lib/host.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "files": [
    "lib",
    "engine",
    "runtime",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "licenses",
    "LICENSE"
  ],
  "license": "GPL-3.0-or-later",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:code": "node scripts/build.mjs --code-only",
    "dev:install": "node scripts/install-local.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:local": "npm run build && npm pack --ignore-scripts --pack-destination ../releases",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "test:install": "node scripts/test-install.mjs",
    "assemble": "node scripts/assemble.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XinYu-pumch/LucentThinker.git",
    "directory": "dsh-plugin"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/XinYu-pumch/LucentThinker",
  "bugs": {
    "url": "https://github.com/XinYu-pumch/LucentThinker/issues"
  }
}
