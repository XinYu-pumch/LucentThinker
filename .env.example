# Bootstrap only: used when data/settings.json does not exist.
# After the first start, edit profiles and credentials in the GUI settings page.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=8765

# Main research and final answer: OpenAI-compatible Chat Completions.
MAIN_LLM_MODEL_NAME=deepseek-flash
MAIN_LLM_BASE_URL=https://api.deepseek.com
# Blank inherits DEEPSEEK_API_KEY when the endpoint matches.
MAIN_LLM_API_KEY=
MAIN_LLM_THINKING=enabled
MAIN_LLM_REASONING_EFFORT=high

# Independent extraction: fresh messages for every page.
SUMMARY_LLM_MODEL_NAME=deepseek-flash
SUMMARY_LLM_BASE_URL=https://api.deepseek.com
# Blank reuses main credential only when both endpoints match.
SUMMARY_LLM_API_KEY=
SUMMARY_LLM_THINKING=disabled
SUMMARY_LLM_REASONING_EFFORT=high

# No local token/window/page/question/followup length cap.
# Old MAX_TOKENS / CONTEXT_WINDOW / MAX_OUTPUT_CAP variables are ignored.
# Verified /models max_output_tokens is used; otherwise max_tokens is omitted.
# DeepSeek Search query is validated at 128 characters, never truncated.
